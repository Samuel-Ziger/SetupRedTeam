# Arquivos temporários do Windows
*.tmp
*.log
*.bak
*.swp
*.tar
*.iso
*.img
*.ova
*~
# Arquivos de sistema
Thumbs.db
Desktop.ini
.DS_Store

# Outputs de verificação
defender.tmp
wsl.tmp

# Diretórios de ferramentas baixadas (muito grandes para git)

**/AttackBox/

# Ignorar arquivos muito grandes em pentest/tools/ (excedem limite do GitHub 100MB)
pentest/tools/Solyd-One/baconCN/rockyou.txt

# Binários compilados locais (Go) — não versionar
pentest/exploitation/web/generic/redsmell/redsmell
pentest/recon/passive/redsubv3/redsubv3

# Arquivos compilados
*.exe
*.dll
*.zip
*.tar.gz
*.rar

# Trabalhos de pentest privados (relatórios, dados de cliente) — não enviar ao GitHub
Pentests Privados/

# Credenciais e configurações sensíveis
*.credentials
*.config
*password*.txt
*password*.log
*password*.key
*secret*
# Permitir pasta passwords com wordlists (não são credenciais reais)
!wifi/passwords/
!**/passwords/*.txt

# Node modules (caso use ferramentas JS)
node_modules/
.next/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/

# Logs
*.log
logs/

# IDEs
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Ferramentas específicas (evitar subir binários)
Kali/Ferramentas/zphisher/*.dat
Kali/Ferramentas/zphisher/.sites/

# Output de scripts
output/*
!output/.gitkeep
!output/README.md
results/
loot/
enum/
# Ignorar apenas recon na raiz do repo (output de scripts), não pentest/recon/
/recon/

# Output padronizado - ignorar conteúdo, mas manter estrutura e README
output/*
!output/
!output/.gitkeep
!output/README.md
!output/recon/
!output/exploits/
!output/creds/
!output/screenshots/
!output/reports/
output/**/*
!output/README.md

# Arquivos com nomes muito longos (problema Windows)
# Sourcetrail - binários e dados de teste (podem ser baixados separadamente)
pentest/reverse-engineering/debuggers/sourcetrail/bin/
pentest/reverse-engineering/debuggers/sourcetrail/lib/
**/sourcetrail/**/bin/
**/sourcetrail/**/lib/

# Ferramentas com arquivos de teste grandes (pode ser baixado separadamente se necessário)
# Manter apenas código fonte e documentação
**/test/data/
**/bin/test/
**/test/fixtures/